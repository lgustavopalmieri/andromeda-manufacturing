# Local development environment (gitignored).
# Points to the local infra services under infra/test/postgres and infra/test/keycloak.

PORT=3000
RUN_MIGRATIONS_ON_BOOT=true

# Postgres (infra/test/postgres/docker-compose.yml)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=andromeda
DATABASE_SSL=false
DATABASE_LOGGING=false

# Keycloak (infra/test/keycloak/docker-compose.yml)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_CLIENT_ID=andromeda-backend
KEYCLOAK_CLIENT_SECRET=andromeda-backend-secret

# AWS / LocalStack (infra/test/localstack/docker-compose.yml)
# Run infra/test/localstack/bootstrap.sh once after starting LocalStack to create the queues.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
SNS_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:andromeda-events
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/andromeda-events
SQS_EVENTS_DLQ_URL=http://localhost:4566/000000000000/andromeda-events-dlq

# Email (infra/test/mailpit/docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@andromeda.io

# Frontend
FRONTEND_URL=http://localhost:5173
