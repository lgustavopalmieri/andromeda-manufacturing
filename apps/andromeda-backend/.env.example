PORT=3000

# PostgreSQL. Schema changes run only when explicitly enabled; production deploys normally migrate separately.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=andromeda
DATABASE_SSL=false
RUN_MIGRATIONS_ON_BOOT=false

# Keycloak access-token verification. The issuer must be the realm URL.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/andromeda
KEYCLOAK_AUDIENCE=andromeda-backend
# Optional: defaults to $KEYCLOAK_ISSUER_URL/protocol/openid-connect/certs
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/andromeda/protocol/openid-connect/certs

# Transactional outbox relay. Leave both SQS variables unset to disable the worker locally.
# The published envelope and the `eventId` message attribute are the idempotency key for consumers.
# OUTBOX_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/andromeda-events.fifo
# OUTBOX_AWS_REGION=us-east-1
# OUTBOX_AWS_ENDPOINT_URL=http://localhost:4566
# OUTBOX_RELAY_POLL_INTERVAL_MS=1000
# OUTBOX_RELAY_BATCH_SIZE=20
# OUTBOX_RELAY_LEASE_DURATION_MS=30000
# OUTBOX_RELAY_RETRY_BASE_DELAY_MS=1000
# OUTBOX_RELAY_RETRY_MAX_DELAY_MS=300000
