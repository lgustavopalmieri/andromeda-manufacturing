{
  "name": "andromeda-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/main.ts",
    "build": "tsup",
    "start": "NODE_ENV=production node dist/main.js",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "3.840.0",
    "@aws-sdk/client-sns": "3.840.0",
    "@aws-sdk/client-sqs": "3.840.0",
    "@keycloak/keycloak-admin-client": "^26.7.2",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "nodemailer": "6.10.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "^8.23.1",
    "@types/pino": "^7.0.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "12.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
